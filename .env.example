PORT=3001
XBOX_HOST=0.0.0.0
XBOX_THREADS=4
XBOX_LOG_LEVEL=info
TOKEN_FILE=data/tokens.json

XBOX_CLIENT_ID=1950a258-227b-4e31-a9cf-717495945fc2
XBOX_CLIENT_SECRET=
XBOX_SCOPE=XboxLive.signin XboxLive.offline_access offline_access
XBOX_REDIRECT_URI=http://localhost:3001/
XBOX_AUTHORIZE_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/authorize
XBOX_TOKEN_URL=https://login.microsoftonline.com/consumers/oauth2/v2.0/token
XBOX_PKCE=true

# Email and password sign-in (POST /api/auth/password).
# Uses the Xbox app client id with the MBI_SSL scope and the desktop redirect, so the
# browser flow ends on https://login.live.com/oauth20_desktop.srf#access_token=... when
# Microsoft asks for an extra verification step.
XBOX_PASSWORD_LOGIN=true
XBOX_PASSWORD_CLIENT_ID=000000004C12AE6F
XBOX_PASSWORD_SCOPE=service::user.auth.xboxlive.com::MBI_SSL
XBOX_PASSWORD_AUTHORIZE_URL=https://login.live.com/oauth20_authorize.srf
XBOX_PASSWORD_TOKEN_URL=https://login.live.com/oauth20_token.srf
XBOX_PASSWORD_REDIRECT_URI=https://login.live.com/oauth20_desktop.srf

# Legacy Xbox Live SDK mode (client 00000000402b5328 + MBI_SSL scope).
# The redirect points at the Microsoft desktop page, so the authorization code is
# copied from the browser address bar and pasted into POST /api/auth/code.
# XBOX_LEGACY_AUTHORIZE=true
# XBOX_CLIENT_ID=00000000402b5328
# XBOX_SCOPE=service::user.auth.xboxlive.com::MBI_SSL
# XBOX_REDIRECT_URI=https://login.live.com/oauth20_desktop.srf
# XBOX_AUTHORIZE_URL=https://login.live.com/oauth20_authorize.srf
# XBOX_TOKEN_URL=https://login.live.com/oauth20_token.srf
# XBOX_PKCE=false

# Cookie sign-in profile (POST /api/auth/cookie).
# Independent from the PKCE profile above: the cookie flow always uses the legacy
# Microsoft Live endpoints with the Xbox client id and the MBI_SSL scope.
XBOX_COOKIE_CLIENT_ID=00000000402b5328
XBOX_COOKIE_SCOPE=service::user.auth.xboxlive.com::MBI_SSL
XBOX_COOKIE_AUTHORIZE_URL=https://login.live.com/oauth20_authorize.srf
XBOX_COOKIE_TOKEN_URL=https://login.live.com/oauth20_token.srf
XBOX_COOKIE_REDIRECT_URI=https://login.live.com/oauth20_desktop.srf

XBOX_HTTP_TIMEOUT_MS=15000
XBOX_HTTP_CONNECT_TIMEOUT_MS=8000
XBOX_HTTP_RETRIES=2
XBOX_AUTH_TIMEOUT_MS=12000
